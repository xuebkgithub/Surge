#!name=飞书 Feishu / Lark 内网放行
#!desc=飞书企业内网防火墙域名与 IP 白名单（客户端 + 视频会议信令/媒体 + 会议特效）。来源：飞书帮助中心 360044683233（文档更新于 2026/03/06），已剔除 2025-03-31 裁撤 IP。默认策略 DIRECT，可在安装时通过 policy 参数改为任意策略组。
#!category=Feishu
#!arguments=policy:DIRECT
#!arguments-desc=policy: 飞书相关流量走的策略（默认 DIRECT 直连；可填入你配置文件中已有的策略组名称，如 PROXY、香港节点 等）

[Rule]
# ===== 飞书客户端域名白名单 =====
DOMAIN-SUFFIX,feishu.net,{{{policy}}}
DOMAIN-SUFFIX,feishu.cn,{{{policy}}}
DOMAIN-SUFFIX,larkoffice.com,{{{policy}}}
DOMAIN-SUFFIX,feishucdn.com,{{{policy}}}
DOMAIN-SUFFIX,zjurl.cn,{{{policy}}}
DOMAIN-SUFFIX,snssdk.com,{{{policy}}}
DOMAIN-SUFFIX,pstatp.com,{{{policy}}}
DOMAIN-SUFFIX,byteimg.com,{{{policy}}}
DOMAIN-SUFFIX,bytedance.net,{{{policy}}}
DOMAIN-SUFFIX,bytedance.com,{{{policy}}}
DOMAIN-SUFFIX,byted-static.com,{{{policy}}}
DOMAIN-SUFFIX,bytegoofy.com,{{{policy}}}
DOMAIN-SUFFIX,feishu-3rd-party-services.com,{{{policy}}}
DOMAIN-SUFFIX,bytehwm.com,{{{policy}}}
DOMAIN-SUFFIX,ttwebview.com,{{{policy}}}
DOMAIN-SUFFIX,bytegecko.com,{{{policy}}}
DOMAIN-SUFFIX,bytescm.com,{{{policy}}}
DOMAIN-SUFFIX,kundou.cn,{{{policy}}}
DOMAIN-SUFFIX,bytetos.com,{{{policy}}}
DOMAIN-SUFFIX,zijieapi.com,{{{policy}}}
DOMAIN-SUFFIX,byteeffecttos.com,{{{policy}}}
DOMAIN-SUFFIX,bytednsdoc.com,{{{policy}}}
DOMAIN-SUFFIX,bytedanceapi.com,{{{policy}}}
DOMAIN-SUFFIX,volcvideo.com,{{{policy}}}
DOMAIN-SUFFIX,feishuimg.com,{{{policy}}}
DOMAIN-SUFFIX,feishuapp.cn,{{{policy}}}
DOMAIN-SUFFIX,getfeishu.cn,{{{policy}}}
DOMAIN-SUFFIX,feishupkg.com,{{{policy}}}
DOMAIN-SUFFIX,feelgood.cn,{{{policy}}}
DOMAIN-SUFFIX,baseopendev.com,{{{policy}}}
DOMAIN-SUFFIX,bytedapm.com,{{{policy}}}
DOMAIN-SUFFIX,ibytedapm.com,{{{policy}}}
DOMAIN-SUFFIX,larkenterprise.com,{{{policy}}}
DOMAIN-SUFFIX,aiforce.cloud,{{{policy}}}
DOMAIN-SUFFIX,aiforce.run,{{{policy}}}
# ===== 视频会议信令服务（额外）=====
DOMAIN-SUFFIX,bytevcloud.com,{{{policy}}}

# ===== 视频会议媒体服务 IP 白名单（已剔除 2025-03-31 裁撤项）=====
